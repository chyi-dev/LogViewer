{
  "id": "gaosheng-jk",
  "name": "高盛 JK 混合串口",
  "version": "1.0.0",
  "presentation": "decoded",
  "ai": {
    "summary": "解析高盛咖啡机主控 AA55、支付板 V1/V2 AA55 与 MDB-RS232 裸帧。帧头 AA55/A55A 走定长帧（按命令字+整帧长度+载荷前缀匹配）；其余十六进制走 MDB。覆盖 Device/Payment/Coffee-Machine 行。"
  },
  "filters": [
    {
      "id": "all",
      "label": "全部"
    },
    {
      "id": "tx",
      "label": "发送"
    },
    {
      "id": "rx",
      "label": "接收"
    }
  ],
  "line_rules": [
    {
      "id": "device-arrow",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+)\\s+Device:\\S+\\s+([><])\\s+([0-9A-Fa-f ]+)$",
      "dir_group": 2,
      "dir_map": {
        ">": "tx",
        "<": "rx"
      },
      "hex_group": 3,
      "time_group": 1
    },
    {
      "id": "payment-arrow",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+)\\s+Payment:\\S+\\s+([><])\\s+([0-9A-Fa-f ]+)$",
      "dir_group": 2,
      "dir_map": {
        ">": "tx",
        "<": "rx"
      },
      "hex_group": 3,
      "time_group": 1
    },
    {
      "id": "coffee-cn",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+)\\s+Coffee-Machine:\\S*?---(发送|接收)：\\s*([0-9A-Fa-f ]+)$",
      "dir_group": 2,
      "dir_map": {
        "发送": "tx",
        "接收": "rx"
      },
      "hex_group": 3,
      "time_group": 1
    }
  ],
  "frame": {
    "kind": "mixed",
    "tx_header": [
      170,
      85
    ],
    "rx_header": [
      165,
      90
    ],
    "checksum": "sum8_before_last",
    "device_bases": [
      8,
      16,
      24,
      48,
      64,
      72,
      80,
      88,
      96,
      104,
      112
    ]
  },
