[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %f
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=text/plain;text/x-log;application/x-logviewer-alog;application/x-logviewer-xlog;application/x-logviewer-logs;
