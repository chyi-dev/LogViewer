{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogViewer",
  "version": "0.1.0",
  "identifier": "com.chyi.log.viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogViewer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/log-viewer.desktop",
        "files": {
          "/usr/share/mime/packages/log-viewer.xml": "./linux/log-viewer-mime.xml"
        },
        "postInstallScript": "./linux/postinst.sh"
      },
      "rpm": {
        "desktopTemplate": "./linux/log-viewer.desktop",
        "files": {
          "/usr/share/mime/packages/log-viewer.xml": "./linux/log-viewer-mime.xml"
        },
        "postInstallScript": "./linux/postinst.sh"
      }
    }
  }
}
