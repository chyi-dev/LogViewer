{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com.chyi.log.viewer/schema/rulepack-v1.schema.json",
  "title": "LogViewer RulePack v1",
  "type": "object",
  "required": ["id", "name", "version", "line_rules", "frame"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "ai": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" }
      }
    },
    "presentation": {
      "type": "string",
      "enum": ["decoded", "raw_hex"],
      "default": "decoded"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "line_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pattern", "dir_group", "dir_map", "hex_group"],
        "properties": {
          "id": { "type": "string" },
          "pattern": { "type": "string", "maxLength": 4096 },
          "dir_group": { "type": "integer", "minimum": 1 },
          "dir_map": {
            "type": "object",
            "additionalProperties": { "type": "string", "enum": ["tx", "rx"] }
          },
          "hex_group": { "type": "integer", "minimum": 1 },
          "time_group": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "frame": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["length_prefix", "mdb_adapter", "mixed"],
          "default": "length_prefix"
        },
        "tx_header": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "rx_header": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "checksum": {
          "type": "string",
          "enum": ["sum8_before_last", "none"]
        },
        "device_bases": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "name", "title"],
        "additionalProperties": false,
        "properties": {
          "cmd": { "type": "integer", "minimum": 0, "maximum": 255 },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "dir": { "type": "string", "enum": ["tx", "rx"] },
          "sub": { "type": "integer", "minimum": 0, "maximum": 255 },
          "role": {
            "type": "string",
            "enum": ["command", "report", "reply", "control", "event"]
          },
          "checksum": { "type": "string", "enum": ["none", "sum8_tail"] },
          "len": { "type": "integer", "minimum": 1 },
          "payload_prefix": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "description": "Optional payload bytes after the command byte (length_prefix / mixed)."
          },
          "decode": { "type": "array" },
          "view": {
            "type": "array",
            "maxItems": 32,
            "description": "Optional declarative card layout. Omit for default clause sentence.",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "const": "heading" },
                    "text": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "bind"],
                  "properties": {
                    "type": { "const": "kv" },
                    "bind": { "type": "string", "minLength": 1 },
                    "label": { "type": "string" }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "bind"],
                  "properties": {
                    "type": { "const": "status" },
                    "bind": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "bind"],
                  "properties": {
                    "type": { "const": "flags" },
                    "bind": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "const": "hex" },
                    "bind": { "type": "string", "minLength": 1 },
                    "from_bytes": {
                      "type": "array",
                      "items": { "type": "integer", "minimum": 0 },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "label": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
